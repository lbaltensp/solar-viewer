# Copy to .env.local for local overrides. All values are optional.

# Helioviewer API base. Change only if you run your own Helioviewer instance.
HELIOVIEWER_BASE_URL=https://api.helioviewer.org/v2

# Sent on every upstream request so Helioviewer can identify this client.
SOLAR_VIEWER_USER_AGENT=solar-viewer/0.1 (personal near-real-time Sun viewer)
